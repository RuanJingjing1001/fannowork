{
    "schema_version": 1,
    "id": "legal.office.v1",
    "adapter": "legal_office",
    "version": "0.9.0",
    "config": {
        "compose_file": "compose.yaml",
        "actions_file": "actions.json",
        "runtime_image": "fanno-legal-office:runtime-v0.9",
        "runtime_dockerfile": "images/runtime/Dockerfile",
        "reset_strategy": "reseed",
        "execution": {
            "backend": "container",
            "container": {
                "image": "fanno-legal-office:runtime-v0.9",
                "docker_executable": "docker",
                "network": "none",
                "cpu_limit": 2.0,
                "memory_limit": "2g",
                "pids_limit": 256,
                "default_timeout_seconds": 60
            }
        },
        "enabled_actions": [
            "filesystem.list",
            "filesystem.read",
            "filesystem.write",
            "document.extract_text",
            "document.convert",
            "document.append_paragraph",
            "document.create",
            "document.insert_heading",
            "document.insert_paragraph",
            "document.add_table",
            "document.save_as",
            "spreadsheet.inspect_workbook",
            "spreadsheet.read_range",
            "spreadsheet.find",
            "email.search",
            "email.read",
            "email.download_attachment",
            "email.send",
            "calendar.list_calendars",
            "calendar.list_events",
            "calendar.find_events",
            "calendar.create_event",
            "calendar.delete_event",
            "records.get",
            "records.query",
            "records.update"
        ],
        "filesystem": {
            "readable_prefixes": [
                "inputs/",
                "work/",
                "outputs/"
            ],
            "writable_prefixes": [
                "work/",
                "outputs/"
            ],
            "max_file_bytes": 10485760
        },
        "document": {
            "supported_extensions": [
                ".txt",
                ".docx",
                ".pdf"
            ],
            "max_file_bytes": 20971520,
            "max_text_characters": 200000,
            "max_archive_uncompressed_bytes": 52428800,
            "extraction": {
                "timeout_seconds": 60
            },
            "conversion": {
                "backend": "libreoffice",
                "executable": "soffice",
                "timeout_seconds": 60,
                "input_extensions": [
                    ".txt",
                    ".docx",
                    ".odt"
                ],
                "output_formats": [
                    "pdf"
                ],
                "max_output_bytes": 52428800
            },
            "uno": {
                "system_python": "/usr/bin/python3",
                "soffice_executable": "soffice",
                "timeout_seconds": 60,
                "max_insert_characters": 20000,
                "max_output_bytes": 52428800,
                "max_table_rows": 200,
                "max_table_columns": 20,
                "input_extensions": [
                    ".docx",
                    ".odt"
                ],
                "output_extensions": [
                    ".docx",
                    ".odt"
                ]
            }
        },
        "spreadsheet": {
            "supported_extensions": [
                ".xlsx",
                ".ods"
            ],
            "max_file_bytes": 20971520,
            "max_range_cells": 10000,
            "max_scan_cells": 250000,
            "max_query_characters": 500,
            "max_results": 200,
            "uno": {
                "system_python": "/usr/bin/python3",
                "soffice_executable": "soffice",
                "timeout_seconds": 60
            }
        },
        "email": {
            "agent_account": "agent",
            "service": {
                "image": "greenmail/standalone:2.1.8",
                "host": "greenmail",
                "smtp_port": 3025,
                "imap_port": 3143,
                "startup_timeout_seconds": 60
            },
            "timeout_seconds": 15,
            "max_results": 200,
            "max_query_characters": 500,
            "max_subject_characters": 500,
            "max_body_characters": 100000,
            "max_attachment_bytes": 20971520,
            "attachment_writable_prefixes": [
                "work/email-attachments/"
            ],
            "allowed_recipient_domains": [
                "fanno.test",
                "terraverde-env.com",
                "hargrovelinden.com"
            ]
        },
        "calendar": {
            "username": "benchmark",
            "password": "",
            "timeout_seconds": 15,
            "max_results": 200,
            "max_query_characters": 500,
            "max_summary_characters": 500,
            "max_description_characters": 100000,
            "service": {
                "image": "tomsquest/docker-radicale@sha256:6a86c8fd17ff4a10b53487af8d635b68e7b8b38c8770320de56c9d44f45bbd73",
                "url": "http://radicale:5232",
                "startup_timeout_seconds": 60
            }
        }
    },
    "metadata": {
        "domain": "legal",
        "profile": "container",
        "capabilities": [
            "filesystem",
            "document",
            "spreadsheet",
            "records",
            "email",
            "calendar"
        ],
        "task_data_baked_into_image": false
    }
}
